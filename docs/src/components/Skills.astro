---

import Icon from "../components/Icon.astro";
const {name, icon, type, backgroundColour} = Astro.props;
---
   <div class="element">
    <Icon
        type={type}
        name={icon}
        width={24}
        height={24}
        class="skill-icon"
    />
    <p>{name}</p>
</div>

<style define:vars={{ backgroundColour }}>
.element {
    position: relative;
    display: inline-flex;
    align-items: center;

    padding: 10px;
    background-color: var(--backgroundColour);
    border: 2px solid white;
    border-radius: 80px;

    margin-right: 10px;
    margin-top: 10px;

    z-index: 1;
}

/* Blur layer */
.element::before {
    content: "";
    position: absolute;
    inset: -4px; /* extends outside the element */
    border-radius: inherit;

    background: var(--backgroundColour);

    filter: blur(12px);
    opacity: 0.7;

    z-index: -1;
}

p {
    margin: 0;
}
</style>